# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RAW_TOPIC=prothesis/logs/raw
MQTT_PARSED_TOPIC=prothesis/logs/parsed
MQTT_ACTIONS_TOPIC=prothesis/actions
MQTT_QOS=1
MQTT_CLIENT_ID=prothesis-logger

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prothesis_logger
DB_USER=prothesis_user
DB_PASSWORD=prothesis_password

# App
LOG_LEVEL=INFO
