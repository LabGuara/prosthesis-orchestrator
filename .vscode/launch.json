{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Prosthesis Orchestrator",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "debugAdapterPython": "${workspaceFolder}/.venv/Scripts/python.exe",
        "debugLauncherPython": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Run Migrations",
      "type": "debugpy",
      "request": "launch",
      "module": "app.migrate",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "debugAdapterPython": "${workspaceFolder}/.venv/Scripts/python.exe",
        "debugLauncherPython": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    }
  ]
}
