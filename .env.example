# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_LOGS_TOPIC=prothesis/logs/raw
MQTT_LOGS_PARSED_TOPIC=prothesis/logs/parsed
MQTT_COMMAND_LOGS_TOPIC=prothesis/actions
MQTT_COMMAND_LOGS_PARSED_TOPIC=prothesis/actions/parsed
MQTT_QOS=1
MQTT_CLIENT_ID=prothesis-orchestrator
MQTT_TLS=true

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prothesis_logger
DB_USER=prothesis_user
DB_PASSWORD=prothesis_password

# App
LOG_LEVEL=INFO
